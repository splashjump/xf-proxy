# xunfei-proxy 配置模板 —— 复制为 .env 后填入真实值（.env 不提交 git）
# xunfei-proxy.js 启动时自动加载 .env（不覆盖已存在的环境变量）。

# ── 讯飞 API ──────────────────────────────────
# 讯飞星辰 API Key（必填，格式 appId:secret）
XFYUN_API_KEY=
# 上游地址（留空用代码内默认值 https://maas-coding-api.cn-huabei-1.xf-yun.com/v2）
XFYUN_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2

# ── 代理监听 ──────────────────────────────────
PROXY_PORT=3000

# ── 重试策略 ──────────────────────────────────
RETRY_DELAY_MS=500
MAX_RETRIES=50
COOLDOWN_AFTER=10
COOLDOWN_MS=5000

# ── 日志 ──────────────────────────────────────
# none / simple / full（见 xunfei-proxy.js 头注释；默认 simple）
LOG_LEVEL=simple
# 结构化事件日志滚动行数
EVENT_LOG_MAX_LINES=1000
# pi 扩展结构化事件日志开关：默认关闭（不写 proxy-events.jsonl，pi footer 显示 —）
# 本地需要 pi footer 实时状态时设 true 开启
# PI_EVENT_LOG=true
# 日志目录（留空 = <脚本目录>/logs）
# LOG_DIR=

# ── Windows 服务（service.ps1 用）─────────────
SVC_NAME=xf-proxy
# node 可执行文件绝对路径；留空则用系统 PATH 中的 node
# 服务机器上若 node 不在系统 PATH，填绝对路径如 C:\Program Files\nodejs\node.exe
NODE_EXE=

# ── probe 脚本（xf-test/）─────────────────────
# 探针默认模型名
# PROBE_MODEL=xopglm52
