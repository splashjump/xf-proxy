{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "AstronCodingPlan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "讯飞星辰 Coding Plan",
      "options": {
        "baseURL": "http://localhost:3000/v1",
        "apiKey": "local-proxy"
      },
      "models": {
        "xopkimik26": {
          "name": "Kimi-K2.6",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "high": { "reasoningEffort": "high" },
            "off":  { "reasoningEffort": "none" }
          },
          "limit": { "context": 256000, "output": 98000 }
        },
        "xopglm52": {
          "name": "GLM-5.2",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "off":  { "reasoningEffort": "none" },
            "low":  { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max" }
          },
          "limit": { "context": 500000, "output": 128000 }
        },
        "xopglm51": {
          "name": "GLM-5.1",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "off":  { "reasoningEffort": "none" },
            "low":  { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max" }
          },
          "limit": { "context": 200000, "output": 128000 }
        },
        "xopdeepseekv4pro": {
          "name": "DeepSeek-V4-Pro",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "off":  { "reasoningEffort": "none" },
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max" }
          },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "xopdeepseekv4flash": {
          "name": "DeepSeek-V4-Flash",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "off":  { "reasoningEffort": "none" },
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max" }
          },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "astron-code-latest": {
          "name": "default(glm5.2)",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "off":  { "reasoningEffort": "none" },
            "low":  { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max" }
          },
          "limit": { "context": 256000, "output": 128000 }
        }
      }
    }
  }
}
